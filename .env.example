# ثبت خودکار وب‌هوک هنگام اجرای deploy.bat (true / false)
AUTO_SET_WEBHOOK=true

# ارسال نوتیفیکیشن فوری به تلگرام هنگام دریافت فرم تماس (true / false)
NOTIFY_ON_CONTACT=true

# ارسال نوتیفیکیشن فوری به تلگرام هنگام دریافت پیام سفارش/همکاری (true / false)
NOTIFY_ON_ORDER=true

# عنوان منوی مدیریت داخل ربات تلگرام
BOT_ADMIN_TITLE="🤖 پنل مدیریت وب‌سایت"

# ------------------------------------------------------------------------------
# ۱۷. داشبورد مدیریت تحت وب (/admin Dashboard)
# ------------------------------------------------------------------------------
# رمز عبور ورود به پنل ادمین وب‌سایت (/admin)
ADMIN_PASS="ChangeThisPassword123!"

# مدت زمان اعتبار سشن لاگین ادمین (به ساعت)
ADMIN_SESSION_HOURS=24

# عنوان بالای صفحه پنل ادمین
ADMIN_PANEL_TITLE="داشبورد مدیریت و مانیتورینگ سایت"

# ------------------------------------------------------------------------------
# ۱۸. اتصال به هوش مصنوعی گوگل جمینای (Google Gemini AI - اختیاری)
# ------------------------------------------------------------------------------
# کلید API رایگان از https://aistudio.google.com برای خلاصه و برچسب‌گذاری خودکار مطالب
# نمونه: AIzaSyYourGeminiApiKeyHere123456789
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# ۱۹. زیرساخت کلودفلر و پایگاه‌داده KV (Cloudflare Project & KV)
# ------------------------------------------------------------------------------
# نام پروژه در کلودفلر پیجز
CLOUDFLARE_PROJECT_NAME="zeroweb"

# دامنه اختصاصی متصل به پروژه (اختیاری - مثلاً mydomain.com)
CUSTOM_DOMAIN=""

# شناسه KV برای ذخیره‌سازی فایل‌ها و مقالات تلگرامی (اختیاری - خودکار ساخته می‌شود)
FILES_KV_ID=""

# شناسه KV برای پیام‌های دریافتی مخاطبان (اختیاری - خودکار ساخته می‌شود)
CONTACT_KV_ID=""

# ------------------------------------------------------------------------------
# ۲۰. امنیت، محدودیت نرخ درخواست و فیلتر کلمات (Security & Rate Limiting)
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS="*"
RATE_LIMIT_CONTACT_PER_MIN=5
RATE_LIMIT_ORDER_PER_MIN=5
CENSOR_KEYWORDS=""

# ------------------------------------------------------------------------------
# ۲۱. ابزارهای آمارگیر و تایید هویت سئو (Analytics & SEO Verification)
# ------------------------------------------------------------------------------
# کد رهگیری گوگل آنالیتیکس (اختیاری - مثلاً G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=""

# کد تایید گوگل سرچ کنسول (اختیاری)
GOOGLE_SITE_VERIFICATION=""
