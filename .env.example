# ==============================================================================
#  راهنمای جامع پیکربندی و تنظیمات وب‌سایت (.env.example)
#  BUILD YOUR OWN WEBSITE FOR FREE — COMPREHENSIVE CONFIGURATION TEMPLATE
# ==============================================================================
#  تمام بخش‌ها و محتوای سایت را می‌توانید به راحتی از طریق همین فایل شخصی‌سازی کنید!
#  برای شروع، این فایل را با نام .env ذخیره کرده و مقادیر دلخواه خود را بنویسید،
#  سپس کافی است فایل deploy.bat (یا deploy.ps1) را اجرا کنید.
# ==============================================================================

# ------------------------------------------------------------------------------
# ۱. هویت، نام و برندینگ اصلی سایت (Site Identity & Global Branding)
# ------------------------------------------------------------------------------
# نام اصلی وب‌سایت (نمایش در هدر، فوتر و عنوان‌ها)
SITE_NAME="وبسایت رایگان خود را بسازید"

# عنوان کامل تب مرورگر (SEO Browser Title)
SITE_TITLE="وبسایت رایگان خود را بسازید | کلودفلر و مدیریت تلگرامی"

# زیرعنوان و شعار کوتاه برند
SITE_SUBTITLE="پلتفرم رایگان، فوق‌سریع و مدرن با کنترل پنل تلگرام و هاست ابری"

# توضیحات متای سئو برای گوگل، بینگ و پیش‌نمایش تلگرام (SEO Meta Description)
SITE_DESCRIPTION="قالب آماده، پرسرعت و کاملاً رایگان برای ساخت وب‌سایت شخصی و شرکتی روی کلودفلر (Cloudflare Pages) با سیستم مدیریت محتوای تلگرام و پایگاه دانش آنلاین."

# نام نویسنده یا مدیر سایت
SITE_AUTHOR="مدیر سایت"

# کلمات کلیدی سئو (با کاما از هم جدا کنید)
SITE_KEYWORDS="ساخت سایت رایگان, کلودفلر پیجز, ربات تلگرام cms, وبلاگ نویسی, پورتفولیو, هاست رایگان, طراحی سایت"

# دامنه پیش‌فرض شما روی کلودفلر یا دامنه اختصاصی (مثلاً mysite.pages.dev یا yourdomain.com)
SITE_DOMAIN="my-free-website.pages.dev"

# زبان وب‌سایت: 'fa' برای فارسی | 'en' برای انگلیسی
SITE_LANG="fa"

# جهت نوشتاری سایت: 'rtl' برای راست‌به‌چپ (فارسی) | 'ltr' برای چپ‌به‌راست
SITE_DIR="rtl"

# تم پیش‌فرض سایت هنگام اولین ورود: 'dark' (تیره مدرن) یا 'light' (روشن تمیز)
DEFAULT_THEME="dark"

# رنگ اصلی سازمانی (کد هگزادسیمال رنگ المان‌ها، دکمه‌ها و های‌لایت‌ها)
# نمونه‌ها: #3b82f6 (آبی الکتریک), #10b981 (سبز زمردی), #8b5cf6 (بنفش سایبر), #f59e0b (طلایی امبر), #ec4899 (رز نئونی)
ACCENT_COLOR="#3b82f6"

# رنگ هاور دکمه‌ها (اختیاری - در صورت خالی بودن خودکار تنظیم می‌شود)
ACCENT_COLOR_HOVER="#60a5fa"

# متن لوگوی برند در نوار ناوبری بالا
BRAND_LOGO_TEXT="سایت من"

# متن کوچک زیر لوگو در نوار ناوبری
BRAND_LOGO_SUBTITLE="میزبانی ابری کلودفلر"

# ------------------------------------------------------------------------------
# ۲. منوی ناوبری و دکمه‌های سربرگ (Navigation & Header Links)
# ------------------------------------------------------------------------------
NAV_LINK_ABOUT="ویژگی‌ها"
NAV_LINK_PORTFOLIO="پلتفرم‌ها"
NAV_LINK_SERVICES="امکانات"
NAV_LINK_DOCS="مستندات"
