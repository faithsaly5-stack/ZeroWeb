NAV_LINK_QA="پرسش و پاسخ"
NAV_CTA_TEXT="شروع رایگان"
NAV_CTA_URL="#order"

# ------------------------------------------------------------------------------
# ۳. بخش هیرو و بنر اصلی (Hero Section & Call To Actions)
# ------------------------------------------------------------------------------
# نشان کپسولی بالای تیتر اصلی هیرو
HERO_BADGE="⚡ میزبانی ۱۰۰٪ رایگان &nbsp;·&nbsp; کلودفلر &nbsp;·&nbsp; سیستم مدیریت تلگرام"

# تیتر درشت و اصلی صفحه (H1)
HERO_TITLE="ساخت و راه‌اندازی رایگان وب‌سایت"

# زیرعنوان متصل به تیتر اصلی هیرو
HERO_SUBTITLE="کلودفلر و سیستم مدیریت تلگرام"

# پاراگراف معرفی و متن توضیحات هیرو
HERO_LEAD="وب‌سایت شخصی و حرفه‌ای خود را به‌صورت کاملاً رایگان روی زیرساخت پرسرعت Cloudflare پیاده‌سازی کنید و تمام محتوا، نظرات و فایل‌ها را مستقیماً از تلگرام مدیریت نمایید."

# شعار تکمیلی در انتهای بخش معرفی هیرو
HERO_TAGLINE="شبکه جهانی لبه ابری · هزینه ماهانه صفر · تنظیم کامل از طریق فایل .env"

# دکمه اصلی اقدام به عمل (Primary CTA)
HERO_CTA_PRIMARY_TEXT="شروع و ارتباط"
HERO_CTA_PRIMARY_URL="#order"

# دکمه ثانویه اقدام به عمل (Secondary CTA)
HERO_CTA_SECONDARY_TEXT="مشاهده مستندات"
HERO_CTA_SECONDARY_URL="/docs.html"

# ------------------------------------------------------------------------------
# ۴. تب‌های تعاملی هیرو (Interactive Focus Highlights)
# ------------------------------------------------------------------------------
HERO_FOCUS_1_BTN="☁️ هاست ابری رایگان"
HERO_FOCUS_1_TITLE="☁️ میزبانی پرسرعت روی شبکه لبه جهانی کلودفلر"
HERO_FOCUS_1_DESC="استقرار با یک کلیک از طریق deploy.bat. بهره‌مندی از ۱۰۰ هزار درخواست رایگان روزانه، گواهی امنیتی SSL خودکار، فایروال ضد DDoS و اتصال دامنه اختصاصی."

HERO_FOCUS_2_BTN="🤖 مدیریت تلگرام"
HERO_FOCUS_2_TITLE="🤖 کنترل پنل و مدیریت کامل محتوا از تلگرام"
HERO_FOCUS_2_DESC="دریافت پیام‌های بازدیدکنندگان، انتشار مقالات و مستندات، ویرایش مطالب و مشاهده آمار تلمتری به‌صورت زنده و مستقیم از تلفن همراه."

HERO_FOCUS_3_BTN="🛠 شخصی‌سازی با .env"
HERO_FOCUS_3_TITLE="🛠 ۱۰۰٪ شخصی‌سازی بدون کدنویسی از طریق .env"
HERO_FOCUS_3_DESC="تغییر تمام عنوان‌ها، رنگ‌ها، متن‌های هیرو، شمارنده‌های آماری، کارت‌های پلتفرم و اطلاعات ارتباطی فقط با ویرایش یک فایل .env."

